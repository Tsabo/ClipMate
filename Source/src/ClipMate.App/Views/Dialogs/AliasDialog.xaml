<dx:ThemedWindow x:Class="ClipMate.App.Views.Dialogs.AliasDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                 Title="Rename"
                 Width="420"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 SizeToContent="Height">

    <dx:ThemedWindow.DialogButtons>
        <dx:ThemedWindowDialogButton Content="OK"
                                     IsDefault="True"
                                     DialogResult="OK" />
        <dx:ThemedWindowDialogButton Content="Cancel"
                                     IsCancel="True"
                                     DialogResult="Cancel" />
    </dx:ThemedWindow.DialogButtons>

    <dxlc:LayoutControl Orientation="Vertical" Padding="16">
        <dxlc:LayoutItem Label="Show as:">
            <dxe:TextEdit x:Name="AliasTextEdit"
                          MaxLength="64" />
        </dxlc:LayoutItem>
        <TextBlock x:Name="HintText"
                   Foreground="Gray"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
    </dxlc:LayoutControl>
</dx:ThemedWindow>
