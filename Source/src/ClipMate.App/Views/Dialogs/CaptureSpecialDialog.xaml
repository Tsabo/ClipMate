<dx:ThemedWindow x:Class="ClipMate.App.Views.Dialogs.CaptureSpecialDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:vm="clr-namespace:ClipMate.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:CaptureSpecialViewModel}"
                 Title="Capture Special"
                 Width="420"
                 Height="420"
                 MinWidth="320"
                 MinHeight="260"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">

    <dx:ThemedWindow.DialogButtons>
        <dx:ThemedWindowDialogButton Content="OK"
                                     IsDefault="True"
                                     DialogResult="OK" />
        <dx:ThemedWindowDialogButton Content="Cancel"
                                     IsCancel="True"
                                     DialogResult="Cancel" />
    </dx:ThemedWindow.DialogButtons>

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="Check the formats to capture. The Application Profile is not used." />
        <ListBox ItemsSource="{Binding Formats}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CaptureSpecialFormat}">
                    <dxe:CheckEdit IsChecked="{Binding IsSelected}"
                                   Content="{Binding Name}"
                                   AutomationProperties.Name="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</dx:ThemedWindow>
