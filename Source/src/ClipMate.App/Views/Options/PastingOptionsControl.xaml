<UserControl x:Class="ClipMate.App.Views.Options.PastingOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:vm="clr-namespace:ClipMate.App.ViewModels"
             xmlns:controls="clr-namespace:ClipMate.App.Controls"
             xmlns:models="clr-namespace:ClipMate.Core.Models.Configuration;assembly=ClipMate.Core"
             d:DataContext="{d:DesignInstance Type=vm:PowerPasteOptionsViewModel}"
             mc:Ignorable="d">

    <dxlc:LayoutControl Orientation="Vertical" Padding="0">

        <!-- PowerPaste Section -->
        <dxlc:LayoutGroup View="GroupBox" Header="PowerPaste" Orientation="Vertical">

            <dxlc:LayoutGroup Orientation="Horizontal">

                <!-- Loop -->
                <dxlc:LayoutItem>
                    <dxe:CheckEdit Content="Loop (restart sequence at end)"
                                   IsChecked="{Binding PowerPasteLoop}"
                                   ToolTip="When PowerPaste reaches the end, loop back to the beginning" />
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup View="GroupBox" Header="Exploding PowerPaste" Orientation="Vertical">

                <!-- Explode Mode -->
                <dxlc:LayoutItem>
                    <dxe:CheckEdit Content="Explode Into Fragments"
                                   IsChecked="{Binding PowerPasteExplode}"
                                   ToolTip="Split clips into fragments based on delimiters" />
                </dxlc:LayoutItem>

                <!-- Delimiter -->
                <dxlc:LayoutItem Label="Delimiters:" LabelPosition="Left">
                    <dxe:TextEdit Text="{Binding PowerPasteDelimiter, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding PowerPasteExplode}"
                                  ToolTip="Characters used to split fragments. Use \n for newline, \t for tab. Default: ,.;:\n\t" />
                </dxlc:LayoutItem>

                <!-- Trim -->
                <dxlc:LayoutItem>
                    <dxe:CheckEdit Content="Trim whitespace from fragments"
                                   IsChecked="{Binding PowerPasteTrim}"
                                   IsEnabled="{Binding PowerPasteExplode}"
                                   ToolTip="Remove leading and trailing spaces from each fragment" />
                </dxlc:LayoutItem>

                <!-- Include Delimiter -->
                <dxlc:LayoutItem>
                    <dxe:CheckEdit Content="Include delimiter in pasted text"
                                   IsChecked="{Binding PowerPasteIncludeDelimiter}"
                                   IsEnabled="{Binding PowerPasteExplode}"
                                   ToolTip="Append the delimiter character to each fragment" />
                </dxlc:LayoutItem>

            </dxlc:LayoutGroup>

        </dxlc:LayoutGroup>

        <!-- Outbound Clip Filtering (manual: Pasting Options, "Filter Outbound Clips") -->
        <dxlc:LayoutGroup View="GroupBox" Header="Outbound Clip Filtering" Orientation="Vertical"
                          DataContext="{Binding OutboundFilter}">

            <dxlc:LayoutItem>
                <dxe:CheckEdit Content="Filter Outbound Clips"
                               IsChecked="{Binding IsEnabled}"
                               ToolTip="Put clips on the clipboard as plain text only, or as just their image when they have no text. The clip itself keeps all its formats." />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="Filter copies from other programs:" IsEnabled="{Binding IsEnabled}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Active"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:OutboundFilterMode.Active}}"
                                 GroupName="OutboundFilterMode" Margin="0,0,5,0"
                                 ToolTip="As soon as a copy is captured, put it back on the clipboard as plain text." />
                    <RadioButton Content="Passive"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:OutboundFilterMode.Passive}}"
                                 GroupName="OutboundFilterMode"
                                 ToolTip="Put it back as plain text when ClipMate loses focus, as ClipMate 6.5 did." />
                </StackPanel>
            </dxlc:LayoutItem>

            <dxlc:LayoutGroup View="GroupBox" Header="Don't filter clips from these programs" Orientation="Horizontal"
                              ToolTip="Clips copied from these programs go on the clipboard with all their formats. Exclude EXPLORER so files can still be copied.">
                <controls:EditableStringList DataContext="{Binding Exclusions}" />
            </dxlc:LayoutGroup>

        </dxlc:LayoutGroup>

        <!-- Reset Button -->
        <dxlc:LayoutItem>
            <dx:SimpleButton Content="Reset to Defaults"
                             Command="{Binding ResetToDefaultsCommand}"
                             HorizontalAlignment="Left"
                             Padding="12,6" />
        </dxlc:LayoutItem>

    </dxlc:LayoutControl>

</UserControl>
